{
  "protocol_version": "0.1",
  "policy_id": "dosr-policy:hello-python:v1",
  "git": {
    "object_format": "sha1"
  },
  "review": {
    "approved_models": [
      {
        "provider": "mock",
        "model": "deterministic-reviewer-v1",
        "version": "1"
      }
    ],
    "minimum_approvals": 1,
    "prompt_template": "standard-code-review-v1",
    "decision_schema": "dosr-review-decision-v1",
    "max_changed_files": 50,
    "max_patch_bytes": 200000
  },
  "attestors": [
    {
      "key_id": "local-dev-attestor-1",
      "scheme": "eip712-secp256k1",
      "address": "0x1111111111111111111111111111111111111111"
    }
  ],
  "storage": {
    "bundle_format": "git-bundle-v1",
    "distribution": "ipfs"
  }
}
